---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在或已经移动。">
  <section class="not-found container-shell">
    <div class="code mono">ERROR / 404</div>
    <h1>信号丢失。</h1>
    <p>这个地址没有对应的页面，可能是链接写错了，或者内容已经移动。</p>
    <a href={withBase('/')}>返回首页 →</a>
    <div class="trace mono" aria-hidden="true">0110 0100 0111 0010 · NO RESPONSE · 0110 0100</div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 62vh; display: flex; flex-direction: column; justify-content: center; position: relative; overflow: hidden; }
  .code { color: var(--accent); font-size: .72rem; letter-spacing: .1em; }
  h1 { margin: .8rem 0 1rem; font-size: clamp(3.5rem, 11vw, 8rem); line-height: .95; letter-spacing: -.07em; }
  p { max-width: 36rem; color: var(--muted); }
  a { align-self: start; margin-top: 1.5rem; border-bottom: 1px solid var(--accent); padding-bottom: .25rem; color: var(--accent-strong); }
  .trace { position: absolute; right: 0; bottom: 1rem; color: var(--line); font-size: clamp(.7rem, 2vw, 1rem); letter-spacing: .2em; }
</style>
