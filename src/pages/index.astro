---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { intro } from '../config';
import { withBase } from '../lib/urls';

const projects = (await getCollection('projects')).filter((item) => item.data.featured).slice(0, 3);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="container-shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow">Embedded · Hardware · Open Source</div>
        <h1>你好，我是向东。<br /><span>让硬件落地，也让经验开源。</span></h1>
        <p>{intro}</p>
        <div class="hero-actions">
          <a class="primary" href={withBase('/projects/')}>查看开源项目 <span>→</span></a>
          <a href={withBase('/about/')}>了解更多</a>
        </div>
        <SocialLinks />
      </div>

      <div class="hero-visual" aria-label="向东头像占位与电子电路装饰">
        <svg class="circuit" viewBox="0 0 500 500" aria-hidden="true">
          <path d="M34 111h92l38 38h86l44-44h172M34 374h111l44-44h93l34 34h150M72 58v78m357-78v74M112 420v54m294-96v96M250 149v-46m0 295v-68" />
          <circle cx="34" cy="111" r="5"/><circle cx="466" cy="105" r="5"/><circle cx="34" cy="374" r="5"/><circle cx="466" cy="364" r="5"/>
          <circle cx="72" cy="58" r="5"/><circle cx="429" cy="58" r="5"/><circle cx="112" cy="474" r="5"/><circle cx="406" cy="474" r="5"/>
        </svg>
        <div class="avatar-frame">
          <img src={withBase('/avatar-placeholder.svg')} alt="向东的头像占位图" />
          <span class="corner corner-a"></span><span class="corner corner-b"></span>
        </div>
        <div class="signal mono"><span></span> SYSTEM ONLINE</div>
        <div class="hero-note mono">HEBUST / EIE<br />LAB LEAD · 2026</div>
      </div>
    </div>
  </section>

  <section class="stats" aria-label="个人信息概览">
    <div class="container-shell stats-grid">
      <div><strong class="mono">02</strong><span>电子信息工程<br />本科在读</span></div>
      <div><strong class="mono">2025—26</strong><span>连续记录<br />电赛省一等奖</span></div>
      <div><strong class="mono">OPEN</strong><span>硬件与嵌入式<br />项目开源</span></div>
    </div>
  </section>

  <section class="section container-shell">
    <div class="section-head">
      <div><div class="eyebrow">Selected Projects</div><h2 class="section-title">把想法做成能跑的硬件</h2></div>
      <a href={withBase('/projects/')}>全部项目 →</a>
    </div>
    <div class="project-list">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </section>

  <section class="section container-shell latest">
    <div class="section-head">
      <div><div class="eyebrow">Latest Notes</div><h2 class="section-title">最近在记录</h2></div>
      <a href={withBase('/blog/')}>全部文章 →</a>
    </div>
    <div>{posts.map((post, index) => <BlogCard post={post} index={index} />)}</div>
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(3rem, 8vw, 6.5rem) 0 4rem; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.18fr .82fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  h1 { max-width: 49rem; margin: 1.2rem 0 1.4rem; font-size: clamp(2.55rem, 6.5vw, 5.2rem); line-height: 1.04; letter-spacing: -.065em; }
  h1 span { color: var(--muted); font-weight: 540; }
  .hero-copy > p { max-width: 39rem; margin: 0 0 2rem; color: var(--muted); font-size: 1.04rem; }
  .hero-actions { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 2.8rem; font-size: .9rem; font-weight: 650; }
  .hero-actions .primary { display: inline-flex; align-items: center; gap: 1.4rem; background: var(--accent); color: #fff; padding: .8rem 1rem; }
  .hero-actions .primary:hover { background: var(--accent-strong); }
  .hero-actions > a:not(.primary):hover { color: var(--accent); }
  .hero-visual { position: relative; min-height: 29rem; display: grid; place-items: center; }
  .circuit { position: absolute; inset: 0; width: 100%; height: 100%; fill: var(--page); stroke: var(--line); stroke-width: 1.2; }
  .circuit circle { fill: var(--accent); stroke: none; }
  .avatar-frame { position: relative; z-index: 1; width: min(18rem, 70vw); aspect-ratio: 1; background: var(--surface-2); padding: 1rem; box-shadow: var(--shadow); }
  .avatar-frame::before { content: ""; position: absolute; inset: 1rem; border: 1px solid var(--line); }
  .avatar-frame img { position: relative; width: 100%; height: 100%; object-fit: cover; }
  .corner { position: absolute; width: 2.5rem; height: 2.5rem; border-color: var(--accent); }
  .corner-a { left: -.5rem; top: -.5rem; border-left: 2px solid; border-top: 2px solid; }
  .corner-b { right: -.5rem; bottom: -.5rem; border-right: 2px solid; border-bottom: 2px solid; }
  .signal { position: absolute; z-index: 2; left: 0; bottom: 2rem; display: flex; align-items: center; gap: .5rem; background: var(--page); padding: .35rem .5rem; color: var(--muted); font-size: .62rem; letter-spacing: .08em; }
  .signal span { width: .5rem; height: .5rem; border-radius: 50%; background: #34b66b; box-shadow: 0 0 0 .25rem color-mix(in srgb, #34b66b 18%, transparent); }
  .hero-note { position: absolute; z-index: 2; right: 0; top: 2rem; border-left: 1px solid var(--accent); padding-left: .7rem; color: var(--muted); font-size: .62rem; line-height: 1.8; }
  .stats { border-block: 1px solid var(--line); }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .stats-grid > div { display: flex; align-items: center; gap: 1rem; min-height: 6.2rem; padding: 1rem 2rem; border-right: 1px solid var(--line); }
  .stats-grid > div:first-child { padding-left: 0; }
  .stats-grid > div:last-child { border-right: 0; }
  .stats strong { color: var(--accent); font-size: 1.25rem; }
  .stats span { color: var(--muted); font-size: .78rem; line-height: 1.45; }
  .section { padding-top: clamp(5rem, 10vw, 8rem); }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2.2rem; }
  .section-head > a { color: var(--muted); font-size: .85rem; border-bottom: 1px solid var(--line); padding-bottom: .25rem; }
  .section-head > a:hover { color: var(--accent); border-color: var(--accent); }
  .project-list { display: grid; gap: 1.4rem; }
  .latest { max-width: 920px; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } .hero-visual { min-height: 22rem; } .hero-note { right: 1rem; } }
  @media (max-width: 600px) { .hero { padding-top: 2.8rem; } .stats-grid { grid-template-columns: 1fr; } .stats-grid > div { border-right: 0; border-bottom: 1px solid var(--line); padding: 1rem 0; } .stats-grid > div:last-child { border-bottom: 0; } .section-head { align-items: start; flex-direction: column; gap: 1rem; } }
</style>
