---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/urls';

interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index = 0 } = Astro.props;
const cover = project.data.cover ? withBase(project.data.cover) : undefined;
---

<article class="project-card" data-filter-item data-tags={JSON.stringify(project.data.tags)}>
  <a class="project-cover" href={withBase(`/projects/${project.id}/`)} aria-label={`查看${project.data.title}详情`}>
    {cover ? <img src={cover} alt="" loading="lazy" /> : <span class="cover-fallback mono">0{index + 1}</span>}
    <span class="status mono">{project.data.status}</span>
  </a>
  <div class="project-body">
    <div class="project-index mono">PROJECT / {String(index + 1).padStart(2, '0')}</div>
    <h3><a href={withBase(`/projects/${project.id}/`)}>{project.data.title}</a></h3>
    <p>{project.data.description}</p>
    <div class="tags">{project.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
    <div class="project-actions">
      <a href={withBase(`/projects/${project.id}/`)}>阅读详情 →</a>
      <a href={project.data.githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </div>
</article>

<style>
  .project-card { display: grid; grid-template-columns: minmax(13rem, .9fr) 1.1fr; min-height: 18rem; border-top: 1px solid var(--line); background: var(--surface); }
  .project-cover { position: relative; min-height: 15rem; overflow: hidden; background: var(--surface-2); border-right: 1px solid var(--line); }
  .project-cover::after { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg, transparent 50%, color-mix(in srgb, var(--accent) 12%, transparent)); }
  .project-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .project-cover:hover img { transform: scale(1.025); }
  .cover-fallback { position: absolute; right: 1.2rem; bottom: .5rem; color: color-mix(in srgb, var(--accent) 32%, transparent); font-size: 6rem; line-height: 1; }
  .status { position: absolute; z-index: 2; top: 1rem; left: 1rem; padding: .3rem .5rem; background: var(--surface); color: var(--accent-strong); font-size: .68rem; }
  .project-body { padding: 1.6rem; display: flex; flex-direction: column; }
  .project-index { color: var(--accent); font-size: .68rem; letter-spacing: .08em; }
  h3 { margin: .65rem 0 .55rem; font-size: 1.35rem; line-height: 1.25; letter-spacing: -.025em; }
  h3 a:hover { color: var(--accent-strong); }
  p { margin: 0 0 1rem; color: var(--muted); font-size: .92rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: auto; }
  .project-actions { display: flex; gap: 1rem; padding-top: 1.2rem; font-size: .82rem; font-weight: 650; }
  .project-actions a:last-child { margin-left: auto; color: var(--muted); }
  .project-actions a:hover { color: var(--accent); }
  @media (max-width: 680px) { .project-card { grid-template-columns: 1fr; } .project-cover { min-height: 12.5rem; border-right: 0; border-bottom: 1px solid var(--line); } }
</style>
